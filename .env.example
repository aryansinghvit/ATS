# Copy to `.env` (repo root) or `backend/.env`. Process environment variables take precedence.

# ---- General -----------------------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-to-a-long-random-string   # signs local upload URLs + status tokens

# ---- Ports -------------------------------------------------------------------------------
API_PORT=8001                      # ATS FastAPI
API_PUBLIC_URL=http://localhost:8001  # externally reachable API base (local upload URLs)
FRONTEND_PORT=3000                 # Next.js
FRONTEND_URL=http://localhost:3000

# ---- PostgreSQL 16 + pgvector (docker compose up -d postgres) ---------------------------
# Runtime role: restricted (no SUPERUSER / BYPASSRLS / table ownership) so RLS is enforced.
# It is created by the first Alembic migration using the credentials below.
DATABASE_URL=postgresql+asyncpg://ats_app:ats_app@localhost:5432/ats_db
# Owner/superuser role, used only by Alembic migrations.
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ats_db

# ---- Redis 7 (docker compose up -d redis) -----------------------------------------------
REDIS_URL=redis://localhost:6379/0
EVENT_BROKER_BACKEND=redis         # redis (multi-process) | memory (single process)

# ---- M3 Resume Extractor microservice (external, REST + HMAC webhook) ---------------------
M3_EXTRACTOR_URL=http://localhost:8000
M3_EXTRACTOR_API_KEY=
M3_WEBHOOK_SECRET=                 # shared HMAC-SHA256 secret for X-Webhook-Signature
M3_WEBHOOK_URL=                    # default: {API_PUBLIC_URL}/api/v1/webhooks/extractor
M3_MAX_CONCURRENCY=1               # matches the extractor's asyncio.Semaphore(1)
M3_RETRY_DELAYS_SECONDS=5,15,45

# ---- Clerk -------------------------------------------------------------------------------
CLERK_JWKS_URL=                    # https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=                      # https://<your-instance>.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Offline HS256 mock tokens for headless tests / local dev without Clerk (dev & test only).
AUTH_MOCK_MODE=false
MOCK_JWT_SECRET=change-me-to-a-long-random-string

# ---- Local LLM (Ollama) ------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b           # pull once: `ollama pull llama3.2:3b`
OLLAMA_TIMEOUT_SECONDS=120

# ---- Semantic talent pool (FastEmbed, on-device) -----------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./.cache/fastembed
EMBEDDING_MODEL_PATH=              # optional pre-downloaded ONNX folder (skips Hugging Face)
TALENT_POOL_EF_SEARCH=200
RESURFACING_THRESHOLD=0.70        # min cosine similarity for job-publish sourcing alerts
RESURFACING_LIMIT=20

# ---- Candidate communications ------------------------------------------------------------
EMAIL_BACKEND=log                  # log (outbox + logs, dev/test) | smtp
EMAIL_FROM=ATS Recruiting <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
DEFAULT_REJECTION_DELAY_HOURS=48   # workspace setting overrides (24–72)
SCREENING_TOKEN_TTL_HOURS=72

# ---- Candidate screening portal (/screen/<token>) ----------------------------------------
SCREENING_MAX_AUDIO_BYTES=10485760 # 10 MB per voice answer
SCREENING_MAX_AUDIO_SECONDS=90
SCREENING_MAX_TEXT_CHARS=4000
WHISPER_MODEL=base.en              # faster-whisper (CPU int8); ~140 MB download on first use
WHISPER_CACHE_DIR=./.cache/whisper
WHISPER_MODEL_PATH=                # optional pre-downloaded CTranslate2 model folder

# ---- Object storage ----------------------------------------------------------------------
STORAGE_BACKEND=local              # local | s3 | r2
LOCAL_STORAGE_PATH=./storage/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=                   # Cloudflare R2 / MinIO endpoint
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PRESIGNED_URL_TTL_SECONDS=900

# ---- Candidate ingestion -----------------------------------------------------------------
MAX_RESUME_SIZE_BYTES=15728640     # 15 MB
APPLICATION_STATUS_TOKEN_TTL_SECONDS=86400

# ---- HTTP / multi-tenant routing ---------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost
PLATFORM_ROOT_DOMAIN=localhost     # e.g. ats-platform.com -> acme.ats-platform.com
